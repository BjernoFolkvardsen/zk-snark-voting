flowchart-diagram

// Define Phases
Setup {
	 Circuit, CircomCompiler, R1cs, Wasm, Sym, Generate_witness.js, PtauCeremony, PtauFiles, Entropy, ContributePhase2, ZkSetup, Zkey(pkey), ExportVkey, Vkey
}
Voting {
	 input.json, GenWitness, Witness.wtns, ZkProve, proof.json, public.json, Verify
}
